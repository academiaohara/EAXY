# Supabase — valores locales tras `npx supabase start` (ver salida del CLI)
# Para remoto dev: Project Settings → API en https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Solo servidor. Nunca exponer al cliente ni commitear.
# Local: `npx supabase status` → publishable key (cliente) / secret key (servidor)
# Remoto: Project Settings → API → publishable key / secret key
SUPABASE_SECRET_KEY=your-secret-key

# Cifrado reversible de contraseñas de alumnos provisionados (AES-256-GCM).
# Generar: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=your-32-byte-key-base64-encoded

# Desarrollo: abre /aprender sin login usando src/content/curriculum.ts
# (solo fuera de producción; no combinar con E2E_MOCK_CLASSROOM en tests)
CONTENT_PREVIEW_MODE=true
